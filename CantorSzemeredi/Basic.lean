import Mathlib

/-!
# Cantor–Szemerédi: shared basics

This file collects the "Stage 0" notions of the blueprint: syndetic subsets of `ℕ`, and
averages over intervals of indices together with the uniform filter along which all limits
in this project are taken.

See `blueprint/src/chapter/cantor.tex`, Definitions `def:syndetic` and `def:uniform-liminf`.
-/

namespace CantorSzemeredi

open Filter

/-- A set `B ⊆ ℕ` is *syndetic* if it has bounded gaps. -/
def Syndetic (B : Set ℕ) : Prop :=
  ∃ L : ℕ, ∀ n : ℕ, ∃ k ∈ B, n ≤ k ∧ k ≤ n + L

/-- The average of `a` over the interval of indices `[M, N)`.  Equal to `0` when `N ≤ M`. -/
noncomputable def uniformAvg (a : ℕ → ℝ) (M N : ℕ) : ℝ :=
  (∑ n ∈ Finset.Ico M N, a n) / (N - M : ℕ)

/-- The filter on pairs `(M, N)` generated by the sets `{(M, N) | L ≤ N - M}`.

All limits written `lim_{N-M → ∞}` in the paper are limits along this filter; this is what
makes them *uniform* in the left endpoint `M`. -/
def uniformFilter : Filter (ℕ × ℕ) :=
  ⨅ L : ℕ, Filter.principal {p : ℕ × ℕ | L ≤ p.2 - p.1}

/-- The uniform `liminf` of the averages of `a`. -/
noncomputable def uniformLiminf (a : ℕ → ℝ) : ℝ :=
  Filter.liminf (fun p : ℕ × ℕ => uniformAvg a p.1 p.2) uniformFilter

end CantorSzemeredi
