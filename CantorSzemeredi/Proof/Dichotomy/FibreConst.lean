module

public import CantorSzemeredi.Port.Dynamics.CondHS
public import CantorSzemeredi.Port.Dynamics.Fibre
public import CantorSzemeredi.Port.Dynamics.Joining
public import CantorSzemeredi.Proof.Dichotomy.Eigen
public import Mathlib

/-!
# Fibre measures are constant along fibres, and the fibre slice identity

* `ae_ae_condKernel_eq`: for a.e. `x`, for `m_x`-a.e. `y`, `condKernel D y = condKernel D x`
  as measures.  Proof: the countable generating π-system of a standard Borel space plus the
  functional form `ae_ae_integral_condKernel_eq` on the indicators of its members.
* `ae_ae_condKernel_of_ae` : `ae_ae_condKernel` without the measurability side condition.
* `ae_ae_condIntegralOp_eq` (abstract slice identity): for *every* kernel `H` and function
  `b`, for a.e. `x` and `m_x`-a.e. `y`,
  `condIntegralOp D H b y = ∫ z, H (y, z) * b z ∂(condKernel D x)`.  No hypothesis on `H`, `b`.
* `ae_ae_condIntegralOp_orbit` (the form consumed by `ae_fibreTB_of_orbit_data`): the data are real
  coefficient
  sequences `c s : ℤ → ℝ` (in `exists_kernel_data`, `c n = cos (n θ)`, `s n = sin (n θ)`), strongly
  measurable
  kernels `H₀ H₁`, a function `a`, and `f'`, together with the base-a.e. identities **that
  `exists_kernel_data`
  produces**, for each `n : ℤ`,
  `f' ∘ iter n =ᵐ[m] c n • Φ_{H₀}(a ∘ iter n) - s n • Φ_{H₁}(a ∘ iter n)`
  (`Φ = condIntegralOp D`).  Conclusion: for a.e. `x`, for all `n : ℤ`, for `m_x`-a.e. `y`,
  `f' (iter n y) = c n * ∫ H₀ (y, z) a (iter n z) dm_x(z) - s n * ∫ H₁ (y, z) a (iter n z) dm_x(z)`.
* `ae_ae_integrable_row` : for `H` strongly measurable in `L²(λ)` and `b` bounded measurable, for
  a.e. `x` and `m_x`-a.e. `y` the row `z ↦ H (y, z) * b z` is integrable (indeed `L²`) over `m_x`.
  This is the integrability `ae_fibreTB_of_orbit_data` needs to pass from the two rows to the row of
  the combined kernel
  `c n • H₀ - s n • H₁` (`ae_ae_integral_row_comb`).
-/

@[expose] public section

namespace CantorSzemeredi.Proof

open MeasureTheory ProbabilityTheory CSZPort CSZPort.MPS

variable {S : MPS} [StandardBorelSpace S.X]

/-! ### Countability of the π-system generated by a countable family -/

omit [StandardBorelSpace S.X] in
theorem countable_generatePiSystem {α : Type*} {g : Set (Set α)} (hg : g.Countable) :
    (generatePiSystem g).Countable := by
  have hc : {t : Set (Set α) | t.Finite ∧ t ⊆ g}.Countable := Set.countable_ofPred_finite_subset hg
  refine (hc.image (fun t => ⋂₀ t)).mono ?_
  intro s hs
  induction hs using generatePiSystem_induction with
  | base s hs => exact ⟨{s}, ⟨Set.finite_singleton _, by simpa using hs⟩, by simp⟩
  | inter _ _ _ _ _ ih1 ih2 =>
    obtain ⟨t1, ⟨h1f, h1g⟩, rfl⟩ := ih1
    obtain ⟨t2, ⟨h2f, h2g⟩, rfl⟩ := ih2
    exact ⟨t1 ∪ t2, ⟨h1f.union h2f, Set.union_subset h1g h2g⟩, Set.sInter_union _ _⟩

/-! ### Fibre measures are constant along fibres -/

/-- `ae_ae_condKernel` with no measurability hypothesis (pass to a measurable null superset). -/
theorem ae_ae_condKernel_of_ae (D : Factor S) {p : S.X → Prop} (h : ∀ᵐ x ∂S.m, p x) :
    ∀ᵐ x ∂S.m, ∀ᵐ y ∂(condKernel D x), p y := by
  obtain ⟨N, hNsub, hNm, hN0⟩ := exists_measurable_superset_of_null (ae_iff.1 h)
  have h2 := ae_ae_condKernel D (p := fun x => x ∉ N) (by simpa [Set.compl_def] using hNm.compl)
    (by rw [ae_iff]; simpa using hN0)
  filter_upwards [h2] with x hx
  filter_upwards [hx] with y hy
  by_contra hp
  exact hy (hNsub hp)

/-- The fibre measures are constant along fibres: for a.e. `x`, for `m_x`-a.e. `y`,
`condKernel D y = condKernel D x`. -/
theorem ae_ae_condKernel_eq (D : Factor S) :
    ∀ᵐ x ∂S.m, ∀ᵐ y ∂(condKernel D x), condKernel D y = condKernel D x := by
  classical
  set P : Set (Set S.X) :=
    generatePiSystem (MeasurableSpace.countableGeneratingSet S.X) with hP
  have hPc : P.Countable :=
    countable_generatePiSystem MeasurableSpace.countable_countableGeneratingSet
  have hPm : ∀ B ∈ P, MeasurableSet B := by
    intro B hB
    induction hB using generatePiSystem_induction with
    | base s hs => exact MeasurableSpace.measurableSet_countableGeneratingSet hs
    | inter _ _ _ _ _ h1 h2 => exact h1.inter h2
  have key : ∀ B : P, ∀ᵐ x ∂S.m, ∀ᵐ y ∂(condKernel D x),
      condKernel D y B = condKernel D x B := by
    intro B
    have hB := hPm B B.2
    have := ae_ae_integral_condKernel_eq D (g := B.1.indicator (fun _ => (1 : ℝ)))
      (measurable_const.indicator hB) (C := 1) (fun x => by
        by_cases hx : x ∈ B.1 <;> simp [Set.indicator, hx])
    filter_upwards [this] with x hx
    filter_upwards [hx] with y hy
    rw [integral_indicator hB, integral_indicator hB] at hy
    simp only [integral_const, MeasureTheory.measureReal_restrict_apply_univ, smul_eq_mul,
      mul_one] at hy
    have h1 : condKernel D y B ≠ ⊤ := measure_ne_top _ _
    have h2 : condKernel D x B ≠ ⊤ := measure_ne_top _ _
    rw [← ENNReal.ofReal_toReal h1, ← ENNReal.ofReal_toReal h2]
    exact congrArg ENNReal.ofReal hy
  have : Countable P := hPc.to_subtype
  rw [← ae_all_iff] at key
  filter_upwards [key] with x hx
  rw [← ae_all_iff] at hx
  filter_upwards [hx] with y hy
  refine ext_of_generate_finite P ?_ (isPiSystem_generatePiSystem _) ?_ (by simp)
  · rw [hP, generateFrom_generatePiSystem_eq]
    exact MeasurableSpace.generateFrom_countableGeneratingSet.symm
  · intro B hB
    exact hy ⟨B, hB⟩

/-! ### The fibre slice identity -/

/-- **Abstract slice identity.**  For every kernel `H` and function `b`: for a.e. `x`, for
`m_x`-a.e. `y`, `Φ_H b (y) = ∫ H(y,z) b(z) dm_x(z)`. -/
theorem ae_ae_condIntegralOp_eq (D : Factor S) (H : S.X × S.X → ℝ) (b : S.X → ℝ) :
    ∀ᵐ x ∂S.m, ∀ᵐ y ∂(condKernel D x),
      condIntegralOp D H b y = ∫ z, H (y, z) * b z ∂(condKernel D x) := by
  filter_upwards [ae_ae_condKernel_eq D] with x hx
  filter_upwards [hx] with y hy
  rw [condIntegralOp, hy]

/-- **The form consumed by `ae_fibreTB_of_orbit_data`.**  See the module docstring for the
hypotheses. -/
theorem ae_ae_condIntegralOp_orbit (D : Factor S) (c s : ℤ → ℝ)
    (H₀ H₁ : S.X × S.X → ℝ) (a f' : S.X → ℝ)
    (hf : ∀ n : ℤ, (fun x => f' (S.iter n x)) =ᵐ[S.m] fun x =>
      c n * condIntegralOp D H₀ (fun z => a (S.iter n z)) x
        - s n * condIntegralOp D H₁ (fun z => a (S.iter n z)) x) :
    ∀ᵐ x ∂S.m, ∀ n : ℤ, ∀ᵐ y ∂(condKernel D x),
      f' (S.iter n y) = c n * ∫ z, H₀ (y, z) * a (S.iter n z) ∂(condKernel D x)
        - s n * ∫ z, H₁ (y, z) * a (S.iter n z) ∂(condKernel D x) := by
  have h1 : ∀ n : ℤ, ∀ᵐ x ∂S.m, ∀ᵐ y ∂(condKernel D x),
      f' (S.iter n y) = c n * condIntegralOp D H₀ (fun z => a (S.iter n z)) y
        - s n * condIntegralOp D H₁ (fun z => a (S.iter n z)) y :=
    fun n => ae_ae_condKernel_of_ae D (hf n)
  have h2 : ∀ᵐ x ∂S.m, ∀ n : ℤ, ∀ᵐ y ∂(condKernel D x),
      f' (S.iter n y) = c n * condIntegralOp D H₀ (fun z => a (S.iter n z)) y
        - s n * condIntegralOp D H₁ (fun z => a (S.iter n z)) y := ae_all_iff.2 h1
  have h3 : ∀ n : ℤ, ∀ᵐ x ∂S.m, ∀ᵐ y ∂(condKernel D x),
      condIntegralOp D H₀ (fun z => a (S.iter n z)) y
        = ∫ z, H₀ (y, z) * a (S.iter n z) ∂(condKernel D x) ∧
      condIntegralOp D H₁ (fun z => a (S.iter n z)) y
        = ∫ z, H₁ (y, z) * a (S.iter n z) ∂(condKernel D x) := by
    intro n
    filter_upwards [ae_ae_condIntegralOp_eq D H₀ (fun z => a (S.iter n z)),
      ae_ae_condIntegralOp_eq D H₁ (fun z => a (S.iter n z))] with x hx0 hx1
    filter_upwards [hx0, hx1] with y hy0 hy1 using ⟨hy0, hy1⟩
  have h4 := ae_all_iff.2 h3
  filter_upwards [h2, h4] with x hx hx' n
  filter_upwards [hx n, hx' n] with y hy hy'
  rw [hy, hy'.1, hy'.2]

/-- Rows are `L²` (hence integrable against bounded `b`) over the *same* fibre measure. -/
theorem ae_ae_integrable_row (D : Factor S) {H : S.X × S.X → ℝ} (hH : StronglyMeasurable H)
    (hmem : MemLp H 2 (joining D)) {b : S.X → ℝ} (hb : Measurable b) {C : ℝ}
    (hbb : ∀ x, |b x| ≤ C) :
    ∀ᵐ x ∂S.m, ∀ᵐ y ∂(condKernel D x),
      Integrable (fun z => H (y, z) * b z) (condKernel D x) := by
  have hrow := ae_memLp_row D hH hmem
  have hbl : ∀ ν : Measure S.X, IsProbabilityMeasure ν → MemLp b 2 ν := fun ν _ =>
    memLp_of_bounded (a := -C) (b := C) (Filter.Eventually.of_forall fun x => by
      rw [Set.mem_Icc]; exact abs_le.1 (hbb x)) hb.aestronglyMeasurable 2
  filter_upwards [ae_ae_condKernel_eq D, ae_ae_condKernel_of_ae D hrow] with x hx hx'
  filter_upwards [hx, hx'] with y hy hy'
  rw [hy] at hy'
  exact hy'.integrable_mul (hbl _ inferInstance)

/-- The row integral of the combined kernel `c • H₀ - s • H₁` splits, fibrewise. -/
theorem ae_ae_integral_row_comb (D : Factor S) {H₀ H₁ : S.X × S.X → ℝ}
    (hH₀ : StronglyMeasurable H₀) (hH₁ : StronglyMeasurable H₁)
    (hm₀ : MemLp H₀ 2 (joining D)) (hm₁ : MemLp H₁ 2 (joining D))
    {b : S.X → ℝ} (hb : Measurable b) {C : ℝ} (hbb : ∀ x, |b x| ≤ C) (c s : ℝ) :
    ∀ᵐ x ∂S.m, ∀ᵐ y ∂(condKernel D x),
      ∫ z, (c * H₀ (y, z) - s * H₁ (y, z)) * b z ∂(condKernel D x)
        = c * ∫ z, H₀ (y, z) * b z ∂(condKernel D x)
          - s * ∫ z, H₁ (y, z) * b z ∂(condKernel D x) := by
  filter_upwards [ae_ae_integrable_row D hH₀ hm₀ hb hbb,
    ae_ae_integrable_row D hH₁ hm₁ hb hbb] with x hx0 hx1
  filter_upwards [hx0, hx1] with y h0 h1
  have : (fun z => (c * H₀ (y, z) - s * H₁ (y, z)) * b z)
      = fun z => c * (H₀ (y, z) * b z) - s * (H₁ (y, z) * b z) := by
    funext z; ring
  rw [this, integral_sub (h0.const_mul c) (h1.const_mul s), integral_const_mul,
    integral_const_mul]

end CantorSzemeredi.Proof
